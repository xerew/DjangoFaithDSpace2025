#, python-format
msgid "Engagement risk (too slow, %(activity_type)s)"
msgstr "Risco relativo ao envolvimento (demasiado lento, %(activity_type)s)"

#: .\authoringtool\risk_flag_text.py
#, python-format
msgid "Engagement risk (too fast, %(activity_type)s)"
msgstr "Risco relativo ao envolvimento (demasiado rápido, %(activity_type)s)"

#: .\authoringtool\risk_flag_text.py
