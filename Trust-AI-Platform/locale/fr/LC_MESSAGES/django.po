msgstr "Aucun compte élève dans ce groupe."

#: .\usergroups\templates\usergroups\view_group.html
#, python-format
msgid ""
"Its <strong>%(count)s student account(s)</strong> will no longer be able to "
"log in."
msgstr ""
"Les comptes élèves du groupe (<strong>%(count)s</strong>) ne pourront plus "
"se connecter."

#: .\usergroups\templates\usergroups\view_group.html
msgid ""
"All their answers and results are kept, and you can restore the group from "
"the groups list."
msgstr ""
"Toutes leurs réponses et tous leurs résultats sont conservés, et vous pouvez "
"restaurer le groupe depuis la liste des groupes."

#: .\usergroups\templates\usergroups\view_group.html
msgid "Hide"
msgstr "Masquer"

#: .\usergroups\views.py
#, python-format
msgid "Group '%(name)s' created successfully with %(count)d user."
msgid_plural "Group '%(name)s' created successfully with %(count)d users."
msgstr[0] "Groupe « %(name)s » créé avec %(count)d utilisateur."
msgstr[1] "Groupe « %(name)s » créé avec %(count)d utilisateurs."

#: .\usergroups\views.py
#, python-format
msgid ""
"Group '%(name)s' was archived. Its students can no longer log in, but all "
"their work is kept. You can restore it from Archived groups."
msgstr ""
"Le groupe « %(name)s » a été archivé. Ses élèves ne peuvent plus se "
"connecter, mais tous leurs travaux sont conservés. Vous pouvez le restaurer "
"depuis Groupes archivés."

#: .\usergroups\views.py
#, python-format
msgid "Archive group “%(name)s”?"
msgstr "Archiver le groupe « %(name)s » ?"

#: .\usergroups\views.py
#, python-format
msgid ""
"The group is hidden from your list and its %(count)s student account(s) can "
"no longer log in. Their answers and results are kept, and you can restore "
"the group at any time."
msgstr ""
"Le groupe est masqué dans votre liste et ses comptes élèves (%(count)s) ne "
"peuvent plus se connecter. Leurs réponses et leurs résultats sont conservés, "
"et vous pouvez restaurer le groupe à tout moment."

#: .\usergroups\views.py
msgid "Archive group"
msgstr "Archiver le groupe"

#: .\usergroups\views.py
#, python-format
msgid "Group '%(name)s' was restored."
msgstr "Le groupe « %(name)s » a été restauré."

#: .\usergroups\views.py
#, python-format
msgid "Added %(count)d new user to the group."
msgid_plural "Added %(count)d new users to the group."
msgstr[0] "%(count)d nouvel utilisateur ajouté au groupe."
msgstr[1] "%(count)d nouveaux utilisateurs ajoutés au groupe."

#: .\usergroups\views.py
#, python-format
msgid "Removed %(count)d user from the group."
msgid_plural "Removed %(count)d users from the group."
msgstr[0] "%(count)d utilisateur retiré du groupe."
msgstr[1] "%(count)d utilisateurs retirés du groupe."

#: .\usergroups\views.py
#, python-format
msgid ""
"%(count)d of them had already worked on scenarios, so their account was "
"deactivated instead of deleted to keep their work."
msgid_plural ""
"%(count)d of them had already worked on scenarios, so their accounts were "
"deactivated instead of deleted to keep their work."
msgstr[0] ""
"%(count)d d'entre eux avait déjà travaillé sur des scénarios : son compte a "
"donc été désactivé au lieu d'être supprimé, afin de conserver son travail."
msgstr[1] ""
"%(count)d d'entre eux avaient déjà travaillé sur des scénarios : leurs "
"comptes ont donc été désactivés au lieu d'être supprimés, afin de conserver "
"leur travail."

#: .\usergroups\views.py
#, python-format
msgid "Group '%(name)s' updated successfully."
msgstr "Le groupe « %(name)s » a été mis à jour."

#: authoringtool/co_authors.py
msgid "You were added as a co-author"
msgstr "Vous êtes maintenant coauteur d'un scénario"

#: authoringtool/co_authors.py
#, python-format
msgid ""
"%(sender)s added you as a co-author of the scenario \"%(name)s\" on Trust AI "
"Lab. Open it here: %(link)s"
msgstr ""
"%(sender)s vous a ajouté comme coauteur du scénario « %(name)s » sur Trust "
"AI Lab. Ouvrez-le ici : %(link)s"

