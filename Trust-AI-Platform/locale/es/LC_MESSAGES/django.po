#, python-format
msgid "Engagement risk (too slow, %(activity_type)s)"
msgstr "Riesgo de participación (demasiado lento, %(activity_type)s)"

#: .\authoringtool\risk_flag_text.py
#, python-format
msgid "Engagement risk (too fast, %(activity_type)s)"
msgstr "Riesgo de participación (demasiado rápido, %(activity_type)s)"

