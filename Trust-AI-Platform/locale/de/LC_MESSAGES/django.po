#, python-format
msgid ""
"Matching activities share %(shared)s of their words; a translation must "
"share less than %(limit)s, or it is taken for a same-language copy."
msgstr ""
"Zugeordnete Aktivitäten haben %(shared)s ihrer Wörter gemeinsam; eine "
"Übersetzung muss weniger als %(limit)s gemeinsam haben, sonst gilt sie als "
"Kopie in derselben Sprache."

#: .\authoringtool\translation_matching.py
