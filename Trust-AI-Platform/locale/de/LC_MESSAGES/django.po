#, python-format
msgid ""
"Confidence %(confidence)s%%; at least %(minimum)s%% is needed to be listed."
msgstr ""
"Konfidenz %(confidence)s %%; für die Aufnahme in die Liste sind mindestens "
"%(minimum)s %% nötig."

