msgid_plural "Group '%(name)s' created successfully with %(count)d users."
msgstr[0] "Η ομάδα «%(name)s» δημιουργήθηκε με %(count)d χρήστη."
msgstr[1] "Η ομάδα «%(name)s» δημιουργήθηκε με %(count)d χρήστες."

#: .\usergroups\views.py
#, python-format
msgid ""
"Group '%(name)s' was archived. Its students can no longer log in, but all "
"their work is kept. You can restore it from Archived groups."
msgstr ""
"Η ομάδα «%(name)s» αρχειοθετήθηκε. Οι μαθητές/τριες της δεν μπορούν πλέον να "
"συνδεθούν, αλλά όλη η εργασία τους διατηρείται. Μπορείτε να την επαναφέρετε "
"από τις Αρχειοθετημένες ομάδες."

#: .\usergroups\views.py
#, python-format
msgid "Archive group “%(name)s”?"
msgstr "Να αρχειοθετηθεί η ομάδα «%(name)s»;"

#: .\usergroups\views.py
#, python-format
msgid ""
"The group is hidden from your list and its %(count)s student account(s) can "
"no longer log in. Their answers and results are kept, and you can restore "
"the group at any time."
msgstr ""
"Η ομάδα αποκρύπτεται από τη λίστα σας και οι μαθητικοί λογαριασμοί της "
"(%(count)s) δεν μπορούν πλέον να συνδεθούν. Οι απαντήσεις και τα "
"αποτελέσματά τους διατηρούνται και μπορείτε να επαναφέρετε την ομάδα "
"οποιαδήποτε στιγμή."

#: .\usergroups\views.py
msgid "Archive group"
msgstr "Αρχειοθέτηση ομάδας"

#: .\usergroups\views.py
#, python-format
msgid "Group '%(name)s' was restored."
msgstr "Η ομάδα «%(name)s» επαναφέρθηκε."

#: .\usergroups\views.py
#, python-format
msgid "Added %(count)d new user to the group."
msgid_plural "Added %(count)d new users to the group."
msgstr[0] "Προστέθηκε %(count)d νέος χρήστης στην ομάδα."
msgstr[1] "Προστέθηκαν %(count)d νέοι χρήστες στην ομάδα."

#: .\usergroups\views.py
#, python-format
msgid "Removed %(count)d user from the group."
msgid_plural "Removed %(count)d users from the group."
msgstr[0] "Αφαιρέθηκε %(count)d χρήστης από την ομάδα."
msgstr[1] "Αφαιρέθηκαν %(count)d χρήστες από την ομάδα."

#: .\usergroups\views.py
#, python-format
msgid ""
"%(count)d of them had already worked on scenarios, so their account was "
"deactivated instead of deleted to keep their work."
msgid_plural ""
"%(count)d of them had already worked on scenarios, so their accounts were "
"deactivated instead of deleted to keep their work."
msgstr[0] ""
"%(count)d λογαριασμός είχε ήδη εργασία σε σενάρια, οπότε απενεργοποιήθηκε "
"αντί να διαγραφεί, ώστε να διατηρηθεί η εργασία."
msgstr[1] ""
"%(count)d λογαριασμοί είχαν ήδη εργασία σε σενάρια, οπότε απενεργοποιήθηκαν "
"αντί να διαγραφούν, ώστε να διατηρηθεί η εργασία."

#: .\usergroups\views.py
#, python-format
msgid "Group '%(name)s' updated successfully."
msgstr "Η ομάδα «%(name)s» ενημερώθηκε."
