msgstr "Άτομα που το έχουν ήδη λάβει: %(n)d."

#: .\accounts\admin_views.py
msgid "Cannot remove your own staff status."
msgstr ""
"Δεν μπορείτε να αφαιρέσετε την ιδιότητα προσωπικού από τον δικό σας "
"λογαριασμό."

#: .\accounts\admin_views.py
msgid "Cannot delete your own account."
msgstr "Δεν μπορείτε να διαγράψετε τον δικό σας λογαριασμό."

#: .\accounts\admin_views.py
msgid "Cannot delete a superuser."
msgstr "Δεν είναι δυνατή η διαγραφή υπερχρήστη."

#: .\accounts\admin_views.py
msgid ""
"This account has student work (answers, scores or feedback) that must be "
"kept. Use Suspend to block the login instead."
msgstr ""
"Αυτός ο λογαριασμός έχει εργασίες μαθητή/τριας (απαντήσεις, βαθμολογίες ή "
"ανατροφοδότηση) που πρέπει να διατηρηθούν. Χρησιμοποιήστε την Αναστολή για "
"να εμποδίσετε τη σύνδεση."

#: .\accounts\admin_views.py
msgid "Cannot suspend your own account."
msgstr "Δεν μπορείτε να αναστείλετε τον δικό σας λογαριασμό."

#: .\accounts\admin_views.py
msgid "Cannot suspend a superuser account."
msgstr "Δεν είναι δυνατή η αναστολή λογαριασμού υπερχρήστη."

#: .\accounts\admin_views.py
msgid "Role name is required."
msgstr "Το όνομα του ρόλου είναι υποχρεωτικό."

