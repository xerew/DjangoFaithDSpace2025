msgid "Reviewer assigned."
msgstr "Ο επιμελητής ορίστηκε."

#: .\accounts\admin_views.py
msgid "Reviewer removed."
msgstr "Ο επιμελητής αφαιρέθηκε."

#: .\accounts\admin_views.py
msgid "Cannot impersonate while already impersonating."
msgstr ""
"Δεν είναι δυνατή η σύνδεση ως άλλος χρήστης ενώ είστε ήδη συνδεδεμένοι ως "
"άλλος χρήστης."

