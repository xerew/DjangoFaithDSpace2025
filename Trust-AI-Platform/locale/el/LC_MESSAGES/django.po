#: .\accounts\admin_views.py
#, python-format
msgid ""
"\"%(name)s\" has built-in chat and help texts tied to its name, so it cannot "
"be renamed."
msgstr ""
"Η γλώσσα «%(name)s» έχει ενσωματωμένα κείμενα συνομιλίας και βοήθειας που "
"συνδέονται με το όνομά της, γι’ αυτό δεν μπορεί να μετονομαστεί."

#: .\accounts\admin_views.py
#, python-format
msgid ""
"Renamed to \"%(name)s\" and updated %(scenarios)s and %(organizations)s."
msgstr ""
"Η γλώσσα μετονομάστηκε σε «%(name)s» και ενημερώθηκε σε %(scenarios)s και "
"%(organizations)s."

