FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
# CPU-only PyTorch first: the default Linux wheel brings several GB of NVIDIA
# GPU libraries, and the server has no GPU (embeddings run on the CPU, the LLM
# runs on the NTUA machine). torch==2.14.1 in requirements.txt then matches the
# installed 2.14.1+cpu, so pip keeps it and fetches its dependencies from PyPI
# (--no-deps: this pip rejects some of them as the PyTorch index serves them).
RUN pip install --no-cache-dir --no-deps torch==2.14.1+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /app/requirements.txt \
    && pip check

COPY . /app