# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Generate secrets on the server, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
ALLOWED_HOSTS=trust-ai-lab.eu,www.trust-ai-lab.eu
CSRF_TRUSTED_ORIGINS=https://trust-ai-lab.eu,https://www.trust-ai-lab.eu

# Fernet key for the initial student passwords teachers download:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STUDENT_CREDENTIALS_KEY=

# Hash of the code teachers enter to register. Wrap it in single quotes:
# it contains "$", which docker compose would otherwise try to expand.
#   docker compose exec web python manage.py shell -c "from django.contrib.auth.hashers import make_password; print(make_password(input('New code: ')))"
TEACHER_ACCESS_CODE_HASHED=''

EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=

RAG_PDFS_DIR=/data/rag/rag_pdfs
RAG_INDEXES_DIR=/data/rag/rag_indexes
AI_METRICS_CACHE_DIR=/data/ai_metrics_cache
OLLAMA_URL=

# Optional overrides (defaults shown in faithDev/settings.py)
# LLM_PROPOSAL_MODEL=
# LLM_IMAGE_DESCRIPTION_MODEL=
# LLM_TRANSLATION_MODEL=
# RASA_WEBHOOK_URL=http://rasa:5005/webhooks/rest/webhook
