DJANGO_SETTINGS_MODULE=faithDev.settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
EMAIL_HOST_PASSWORD=petu elkw swkm vcsl
ALLOWED_HOSTS=trust-ai-lab.eu,www.trust-ai-lab.eu,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://trust-ai-lab.eu,https://www.trust-ai-lab.eu

# Postgres
POSTGRES_DB=faithdb
POSTGRES_USER=faithuser
POSTGRES_PASSWORD=faithpass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# RAG
RAG_PDFS_DIR=/data/rag/rag_pdfs
RAG_INDEXES_DIR=/data/rag/rag_indexes

# AI CACHE
AI_METRICS_CACHE_DIR=/data/ai_metrics_cache

# OLLAMA URL
OLLAMA_URL=http://host.docker.internal:11434